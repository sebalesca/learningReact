    "@mui/material": "^5.13.5",
    "@mui/x-date-pickers": "^6.7.0",
    "@tanstack/react-query": "^4.29.7",
    "@tanstack/react-query-devtools": "^4.29.19",
    "@tmcw/togeojson": "^5.8.1",
    "@types/react-resizable": "^3.0.4",
    "@types/react-text-mask": "^5.4.14",
    "antd": "^5.5.1",
    "axios": "^1.4.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.8",
    "framer-motion": "^10.12.16",
    "iconsax-react": "^0.0.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "mui-tel-input": "^5.0.0",
