{
  "name": "webportal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 80",
    "build": "tsc && vite build --mode testing --base=/webportal",
    "build:uat": "tsc && vite build --mode uat --base=/webportal",
    "build:prod": "tsc && vite build --mode production --base=/webportal",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test-watch": "vitest",
    "preview": "vite preview",
    "prepare": "cd .. && husky install webportal/.husky",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
